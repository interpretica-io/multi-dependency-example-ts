<?xml version="1.0" ?>
<package version="1.0">
    <description>Multi-dependency Example Test Suite</description>

    <!-- @page mde-ts Multi-dependency Example Test Suite
          @objective Verify that a value still propagates through every stage
                     of each dependency cycle of the multi-dependency-example.

          @par Test Groups:
          - @ref mde-ring - the native FFI ring (C++/Rust/Go/C#/Python), checked step by step against a model
          - @ref mde-web - the HTTP web tier (gateway-rs/service-go/service-cs)
          - @ref mde-webdeps - hypotheses H1-H4 about gateway-rs, service-go, the language builds and the built binaries, plus a smoke test per language
          - @ref mde-graph - the build-time linkage that makes the cycle possible
          - @ref mde-package - runtime dependencies of the example mapped to packages (tsf-package)
          - @ref mde-devtool - rebuilding parts of the example on the agent (tsf-devtool)
          - @ref mde-fs - the example tree on disk: permissions, secrets, integrity (tsf-fs)
          - @ref mde-memmap - ELF images and live mappings of the example (tsf-memorymap)
          - @ref mde-binary - how every binary of the example was built (tsf-cybersec)
          - @ref mde-exposure - what the running web tier listens on and talks to (tsf-cybersec)
          - @ref mde-http - each service of the web tier as an HTTP server (tsf-http)
          - @ref mde-container - the example inside a container (tsf-container)
          - @ref mde-fuzz - the ring's C ABI under a fuzzer (tsf-fuzz)
          - @ref mde-browser - the web tier in a real browser (tsf-playwright)

          @par Notes:
          - The suite drives an already-built example located by TE_TS_MDE_SRC.
            When it is unset, or the example is not built, every group skips.
          - The example ships with a trivial always-true defect injected into
            every source file, which stops each cycle after its first stage.
            The propagation tests are written against the correct behaviour, so
            on the as-shipped example they fail with known-issue verdicts (see
            conf/trc.xml); once the defects are fixed they pass.
    -->

    <author mailto="maximmenshchikov@gmail.com" />

    <session track_conf="silent">
        <!-- @page mde-ts-prologue Test Suite Prologue
              @objective Report where the example is and whether it is built.

              @par Scenario:
              -# Open a session on the agent.
              -# Log TE_TS_MDE_SRC and whether dist/bin exists.
        -->
        <prologue>
            <script name="prologue">
                <objective>
                    Prepare the test environment and report the example under
                    test.

                    @md
                </objective>
            </script>
        </prologue>

        <!-- @page mde-ts-epilogue Test Suite Epilogue
              @objective Finalize test execution.

              @par Scenario:
              -# No cleanup actions are required at suite level.
        -->
        <epilogue>
            <script name="epilogue">
                <objective>
                    Finalize test execution.

                    @md
                </objective>
            </script>
        </epilogue>

        <!-- @page mde-ring Ring Tests
              @objective The native FFI ring (C++/Rust/Go/C#/Python), checked step by step against a model.
        -->
        <run>
            <package name="ring" />
        </run>

        <!-- @page mde-web Web Tier Tests
              @objective The HTTP web tier (gateway-rs/service-go/service-cs).
        -->
        <run>
            <package name="web" />
        </run>

        <!-- @page mde-webdeps Web Dependency Tests
              @objective Hypotheses H1-H4 about the web services, plus a
                         security check and one smoke test per language.
        -->
        <run>
            <package name="webdeps" />
        </run>

        <!-- @page mde-graph Graph Tests
              @objective The build-time linkage that makes the cycle possible.
        -->
        <run>
            <package name="graph" />
        </run>

        <!-- @page mde-package Package Tests
              @objective Runtime dependencies of the example mapped to packages (tsf-package).
        -->
        <run>
            <package name="package" />
        </run>

        <!-- @page mde-devtool Devtool Tests
              @objective Rebuilding parts of the example on the agent (tsf-devtool).
        -->
        <run>
            <package name="devtool" />
        </run>


        <!-- @page mde-fs Filesystem Tests
              @objective The example tree on disk: permissions, secrets, integrity (tsf-fs).
        -->
        <run>
            <package name="fs" />
        </run>

        <!-- @page mde-memmap Memory Map Tests
              @objective ELF images and live mappings of the example (tsf-memorymap).
        -->
        <run>
            <package name="memmap" />
        </run>

        <!-- @page mde-binary Binary Hardening Tests
              @objective How every binary of the example was built (tsf-cybersec).
        -->
        <run>
            <package name="binary" />
        </run>

        <!-- @page mde-exposure Exposure Tests
              @objective What the running web tier listens on and talks to (tsf-cybersec).
        -->
        <run>
            <package name="exposure" />
        </run>

        <!-- @page mde-http HTTP Tests
              @objective Each service of the web tier as an HTTP server (tsf-http).
        -->
        <run>
            <package name="http" />
        </run>







        <!-- @page mde-container Container Tests
              @objective The example inside a container (tsf-container).
        -->
        <run>
            <package name="container" />
        </run>


        <!-- @page mde-fuzz Fuzzing Tests
              @objective The ring's C ABI under a fuzzer (tsf-fuzz).
        -->
        <run>
            <package name="fuzz" />
        </run>




        <!-- @page mde-browser Browser Tests
              @objective The web tier in a real browser (tsf-playwright).
        -->
        <run>
            <package name="browser" />
        </run>



    </session>
</package>
