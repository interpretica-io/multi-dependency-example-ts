<?xml version="1.0" ?>
<package version="1.0">
    <description>Bench tooling tests: JTAG, flashing, power</description>

    <!-- @page mde-bench Bench Tests
          @objective Exercise the bench modules (JTAG, flashing, power) as far
                     as a host with no bench hardware allows.

          @par Test Groups:
          - @ref mde-bench-jtag_dummy     - OpenOCD's dummy adapter
          - @ref mde-bench-flash_emulated - flashrom's emulated programmer
          - @ref mde-bench-power_window   - energy over a window
          - @ref mde-bench-power_switch   - switching power

          @par Notes:
          - There is no JTAG probe, flash programmer or power instrument here.
            jtag_dummy drives OpenOCD's software dummy adapter; flash_emulated
            uses flashrom's dummy programmer, whose "chip" is a file, and
            flashes an image built from the ring libraries; power_window and
            power_switch skip with concrete reasons, since tsf-power has no
            software energy backend and no outlet is reachable.
    -->

    <author mailto="maximmenshchikov@gmail.com" />

    <session track_conf="silent">
        <!-- @page mde-bench-prologue Bench Group Prologue
              @objective Chart which bench tools the agent has.

              @par Scenario:
              -# Probe each tool and chart its presence.
        -->
        <prologue>
            <script name="prologue">
                <objective>
                    Chart which bench tools the agent has.

                    @md
                </objective>
            </script>
        </prologue>

        <!-- @page mde-bench-epilogue Bench Group Epilogue
              @objective Finalize the bench group.

              @par Scenario:
              -# No group-wide cleanup is required.
        -->
        <epilogue>
            <script name="epilogue">
                <objective>
                    Finalize the bench group.

                    @md
                </objective>
            </script>
        </epilogue>

        <!-- @page mde-bench-jtag_dummy JTAG Dummy Adapter
              @objective Drive tsf-jtag end to end through OpenOCD's dummy
                         adapter on a declared chain, and prove its chain
                         checks catch a board with no live silicon.

              @par Scenario:
              -# Skip unless openocd is installed.
              -# Declare one TAP (mde.cpu, irlen 4, expected 0x4ba00477) on
                 the dummy adapter and run init + scan_chain.
              -# Parse the chain: mde.cpu must be first, with the declared IR
                 length and expected IDCODE.
              -# Known-bad control: nothing drives TDO, so the TAP reads a
                 stuck IDCODE; the stuck-IDCODE check must report it and the
                 chain must not match the expected IDCODE.

              @par Expected Results:
              - PASS with openocd present; SKIP without it.
        -->
        <run name="jtag_dummy">
            <script name="jtag_dummy">
                <objective>
                    A scan chain over OpenOCD's dummy adapter.

                    @md
                </objective>
            </script>
        </run>

        <!-- @page mde-bench-flash_emulated Emulated Flash
              @objective Flash an image built from the ring libraries into
                         flashrom's emulated chip, read it back and verify.

              @par Scenario:
              -# Skip unless flashrom is installed or the build does not know
                 the emulated chip.
              -# Build a 16 MiB image from dist/lib/*.so, padded to the chip.
              -# Write it, read it back and verify the SHA-256 (deep).
              -# Erase and check the chip reads all 0xFF.
              -# Control: corrupt the backing file so the verify must fail.

              @par Expected Results:
              - With flashrom and the dummy programmer: the round trip matches,
                the erase is all 0xFF, the control fails the verify, and the
                test PASSES. Otherwise it SKIPS with the concrete reason. MTD
                over mtdram/nandsim is not attempted (no kernel modules).
        -->
        <run name="flash_emulated">
            <script name="flash_emulated">
                <objective>
                    Ring libraries written to an emulated flash chip and
                    verified.

                    @md
                </objective>
            </script>
        </run>

        <!-- @page mde-bench-power_window Energy Over A Window
              @objective Chart what the kernel's powercap exposes and the
                         profiler backends' availability, then skip the
                         measurement.

              @par Scenario:
              -# Chart the powercap zones and the USB profiler availability.
              -# Skip: tsf-power has no software/RAPL backend and no
                 instrument is reachable.

              @par Expected Results:
              - SKIP with the concrete reason, after the charts.
        -->
        <run name="power_window">
            <script name="power_window">
                <objective>
                    Energy over a window - charted context, then a skip.

                    @md
                </objective>
            </script>
        </run>

        <!-- @page mde-bench-power_switch Switching Power
              @objective Cycle the device's power - which needs hardware.

              @par Scenario:
              -# Skip: no programmable outlet is present or reachable.

              @par Expected Results:
              - SKIP with the concrete reason.
        -->
        <run name="power_switch">
            <script name="power_switch">
                <objective>
                    Switching power - a skip without an outlet.

                    @md
                </objective>
            </script>
        </run>
    </session>
</package>
