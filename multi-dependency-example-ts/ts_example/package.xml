<?xml version="1.0" ?>
<package version="1.0">
    <description>TypeScript example tests</description>

    <!-- @page mde-ts_example TypeScript Example Tests
          @objective Settle H1 to H4 about the TypeScript example. Every test
                     that runs a command logs it with its working directory,
                     exit code, elapsed time and the whole of stdout and
                     stderr, and a failing verdict names the failing step.

          @par Test Groups:
          - @ref mde-ts_example-ts_build - Build (H2)
          - @ref mde-ts_example-ts_run_guess - Start with guess (H2)
          - @ref mde-ts_example-ts_contract - Same reply as Go and C# (H3)
          - @ref mde-ts_example-ts_robust - Endpoint variable, no hardcoded URL, silent peer (H4)
    -->

    <author mailto="midair@localhost" />

    <session track_conf="silent">
        <!-- @page mde-ts_example-prologue TypeScript Example Group Prologue
              @objective Check the tools of the group.

              @par Scenario:
              -# Report TE_TS_MDE_SRC.
              -# Check bash, node, npm, npx, tsc, find, gcc and curl; name what is missing.
        -->
        <prologue>
            <script name="prologue">
                <objective>Check that the tools the group needs are on the agent and name the missing ones. Installs nothing: scripts/midair-setup.sh does that.</objective>
            </script>
        </prologue>

        <!-- @page mde-ts_example-ts_diag Plain diagnostic (H5)
              @objective Run eight plain commands with no helper and show each output and exit code in a verdict.

              @par Scenario:
              -# Run id, pwd, ls -la /work /work/src, node -v, npm -v, npx tsc -v, find for .ts files and ls /work/src/ts with system(), output in /tmp/ts_diag_n.log.
              -# Read each file back; give the first 400 bytes and the exit code in a verdict.
              -# End with success: the test passes whenever it runs.
        -->
        <run name="ts_diag">
            <script name="ts_diag">
                <objective>[H5] Eight plain commands, no helper, no skip: a verdict per command with exit code and first 400 bytes of its log. Passes whenever it runs; verdicts present means H5 is false.</objective>
            </script>
        </run>

        <!-- @page mde-ts_example-ts_control_known_bad Control: known-bad command (H2, H3, H4)
              @objective Check the shell helper of the group against a planted failing command.

              @par Scenario:
              -# Run sh -c 'echo bad &gt;&amp;2; exit 3' through the helper.
              -# Require exit code 3 and the text bad in the verdict text; an empty verdict text means the log capture does not work.
              -# Check a good command and a hang the same way.
        -->
        <run name="ts_control_known_bad">
            <script name="ts_control_known_bad">
                <objective>[H2 H3 H4] Run sh -c 'echo bad &gt;&amp;2; exit 3' through the shell helper; PASS only when the verdict text carries exit code 3 and the text bad; FAIL when it is empty (the log capture does not work), has another exit code or lacks the text.</objective>
            </script>
        </run>

        <!-- @page mde-ts_example-ts_build Build (H2)
              @objective Run build.sh in the project root within 540 s.

              @par Scenario:
              -# Check the runner against a planted hang and signal.
              -# Run build.sh by absolute path in the project root; log command, exit code, time, stdout and stderr in full.
              -# On a failure log the last 50 lines and name the step (npm install, tsc, the C build).
              -# Pass only on exit code 0, compiled .js files written by this build in the TypeScript dist, and an executable scripts/run.sh.
        -->
        <run name="ts_build">
            <script name="ts_build">
                <objective>[H2] Run ./build.sh with output in /tmp/ts_build.log. PASS on exit 0 and ts/dist/main.js; FAIL puts the last 2000 bytes of the log and the exit code in the error. Leaves a marker for the later tests.</objective>
            </script>
        </run>

        <!-- @page mde-ts_example-ts_run_guess Start with guess (H2)
              @objective Run scripts/run.sh guess with a 30 s limit.

              @par Scenario:
              -# Start the web services that exist.
              -# Run the example by absolute path; log command, exit code, time, stdout and stderr in full.
        -->
        <run name="ts_run_guess">
            <script name="ts_run_guess">
                <objective>[H2] Run scripts/run.sh guess (absolute path, project root as working directory) with a 30 s limit against the local web tier. H2 PASS when it exits 0 with output, or is still running at the limit without a crash trace; H2 FAIL on a signal, a crash trace, a non-zero exit or an empty stdout, with exit code, stdout and stderr in the verdict.</objective>
            </script>
        </run>

        <!-- @page mde-ts_example-ts_contract Contract (H3)
              @objective Compare the reply of the TypeScript example with the Go and C# examples byte for byte.

              @par Scenario:
              -# Fail with "H2 build missing" when dist/index.js does not exist.
              -# Check the byte comparison against planted differences.
              -# Start the services; skip the test when the Go example cannot start; a gateway that is not up is a "start-up fault".
              -# Log what the TypeScript process listens on (tapi_netexpose).
              -# Send one fixed set of inputs, one valid guess first, to scripts/run.sh guess and to Go and C#; log all outputs in full.
              -# Compare the TypeScript and Go replies byte for byte; print both on a mismatch. A C# difference is a warning.
        -->
        <run name="ts_contract">
            <script name="ts_contract">
                <objective>[H3 H5] First verdict 'H5 start', then 'H5 build precondition' (dist/main.js; else 'H3 blocked by H2' and FAIL). Sends a valid, an empty, a non-numeric and a 70000-byte input to the Go and TypeScript examples with a 5 s timeout, saves both replies in /tmp, and writes 'H3 input N same' or 'H3 input N differs' with both replies. A known-bad script printing a different reply must be caught by cmp.</objective>
            </script>
        </run>

        <!-- @page mde-ts_example-ts_robust Endpoint Variable and a Silent Peer (H4)
              @objective Three checks with their own messages, plus bad input.

              @par Scenario:
              -# (a) Scan src/ outside comments for a literal http://, https:// or IP address.
              -# (b) Run with GUESS_ENDPOINT on a chosen local port; it must connect there and nowhere else.
              -# (c) Point GUESS_ENDPOINT at a listener that never answers; non-zero exit within 10 s.
              -# (d) Empty, non-numeric and oversize input: no hang, signal or trace.
        -->
        <run name="ts_robust">
            <script name="ts_robust">
                <objective>[H4] After ts_build passed (else blocked by H2): node dist/main.js with EXAMPLE_PORT=9101 EXAMPLE_HOST=127.0.0.1 listens on 127.0.0.1:9101 and not 0.0.0.0 (tapi_netexpose); with both unset on 127.0.0.1:9100; empty, non-numeric, 100000-character and hostile input get 4xx replies and the process lives; SIGTERM and SIGINT give exit code 0.</objective>
            </script>
        </run>

        <!-- @page mde-ts_example-ts_h1_listing Directory listing (H1)
              @objective Run find over /work/src for .ts, tsconfig.json and package.json and record whether a TypeScript example exists.

              @par Scenario:
              -# Check the finder against a planted tree and find against a missing directory.
              -# Run find /work/src -iname '*.ts' -o -iname 'tsconfig.json' -o -iname 'package.json'; log command, exit code, stdout and stderr.
              -# Record in the log and in the verdict whether a TypeScript example exists; do not fail on the finding.
              -# Fail only when find itself errors, printing the error.
        -->
        <run name="ts_h1_listing">
            <script name="ts_h1_listing">
                <objective>[H1] List the project with ls and find, a verdict per command; PASS only when ts/package.json, ts/tsconfig.json and a .ts file exist, with the verdict 'H1 TypeScript example found'; else 'H1 no TypeScript example found' and FAIL.</objective>
            </script>
        </run>

        <!-- @page mde-ts_example-ts_h2_build_guess Build and run (H2)
              @objective build.sh exits 0 and compiles the JavaScript, then scripts/run.sh guess starts without a crash within 30 s.

              @par Scenario:
              -# Check the runner against a planted hang, signal and exit code.
              -# Run build.sh; require exit code 0 and compiled .js files in the TypeScript dist; on a failure print the last 50 lines of the build output.
              -# Start the services, run scripts/run.sh guess with a 30 s timeout; it must exit 0 or still be running at the limit, with no signal and no crash trace.
        -->
        <run name="ts_h2_build_guess">
            <script name="ts_h2_build_guess">
                <objective>[H2] Verdict 'H2 guess alive' after scripts/run.sh guess for 30 s; PASS when still running or exit 0.</objective>
            </script>
        </run>

        <!-- @page mde-ts_example-ts_h3_same_output Same output as Go (H3)
              @objective Send one fixed set of inputs to the TypeScript example and the Go service and compare the replies byte for byte.

              @par Scenario:
              -# Check the byte comparison against planted differences.
              -# Start the services; skip the test when the Go example cannot start.
              -# Send value 42 hops 3 (a valid guess) and three more fixed inputs to the example and to the Go service.
              -# Fail on any byte of difference, printing both replies.
        -->
        <run name="ts_h3_same_output">
            <script name="ts_h3_same_output">
                <objective>[H3] Reads the reply files saved by ts_contract (or collects them the same way) and compares each pair with cmp; one verdict per input; PASS only when all four are the same.</objective>
            </script>
        </run>

        <!-- @page mde-ts_example-ts_h4_port_badinput Configured port and bad input (H4)
              @objective The example listens only on the configured address and port, answers empty and bad input with an error in 5 s and exits 0 on a normal stop.

              @par Scenario:
              -# Check tapi_netexpose and the reply classifier against planted listeners and replies.
              -# Start the example with the address variables set to 127.0.0.1 and another port in its configuration.
              -# tapi_netexpose: it listens on that port and on no other.
              -# Send empty and malformed requests, a non-numeric guess and a 1 MB string: a 4xx reply within 5 s each, process alive.
              -# Stop it with SIGTERM: exit code 0.
        -->
        <run name="ts_h4_port_badinput">
            <script name="ts_h4_port_badinput">
                <objective>[H4] After ts_build passed (else blocked by H2): the configured and default listen address and port checked with tapi_netexpose, error replies to empty, non-numeric and 100000-character input with a live process after each, exit code 0 on SIGTERM and on SIGINT.</objective>
            </script>
        </run>
    </session>
</package>
