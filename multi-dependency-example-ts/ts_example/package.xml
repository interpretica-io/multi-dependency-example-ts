<?xml version="1.0" ?>
<package version="1.0">
    <description>TypeScript example tests</description>

    <!-- @page mde-ts_example TypeScript Example Tests
          @objective Settle H1, H2 and H3 about the TypeScript example, one
                     test per step, each logging its command, exit code,
                     elapsed time and the last 40 lines of stdout and stderr.

          @par Test Groups:
          - @ref mde-ts_example-ts_build - Build in a clean copy (H1)
          - @ref mde-ts_example-ts_run_guess - Start with guess (H1)
          - @ref mde-ts_example-ts_contract - Same answer as Go and C# (H2)
          - @ref mde-ts_example-ts_robust - Endpoint variable, no hardcoded URL, silent peer (H3)
    -->

    <author mailto="midair@localhost" />

    <session track_conf="silent">
        <!-- @page mde-ts_example-prologue TypeScript Example Group Prologue
              @objective Check the tools of the group.

              @par Scenario:
              -# Report TE_TS_MDE_SRC.
              -# Check bash, node, npm, npx, gcc and curl; name what is missing.
        -->
        <prologue>
            <script name="prologue">
                <objective>Check that the tools the group needs are on the agent and name the missing ones. Installs nothing: scripts/midair-setup.sh does that.</objective>
            </script>
        </prologue>

        <!-- @page mde-ts_example-ts_build Build (H1)
              @objective Run ./build.sh in a clean copy (no node_modules, no dist) within 540 s.

              @par Scenario:
              -# Check the runner against a planted hang and signal.
              -# Copy the project without node_modules and dist; check both are absent.
              -# Run ./build.sh in the copy; log command, exit code, time, output.
              -# On a failure print the last 40 lines and name the step (npm install, tsc, the C build).
              -# Pass only on exit code 0 and an existing typescript/dist/index.js.
        -->
        <run name="ts_build">
            <script name="ts_build">
                <objective>[H1] Run ./build.sh in a clean copy of the project with a 540 s limit. H1 PASS only when it exits 0 and typescript/dist/index.js exists; H1 FAIL naming npm install, tsc or the C build, with the last 40 lines of the output in the log.</objective>
            </script>
        </run>

        <!-- @page mde-ts_example-ts_run_guess Start with guess (H1)
              @objective Run ./scripts/run.sh guess within 30 s.

              @par Scenario:
              -# Start the web services that exist.
              -# Run the example; log command, exit code, time, output tails.
        -->
        <run name="ts_run_guess">
            <script name="ts_run_guess">
                <objective>[H1] Run ./scripts/run.sh guess with a 30 s limit against the local web tier. H1 PASS on exit code 0 and a non-empty stdout; H1 FAIL on a non-zero exit, a timeout or an empty stdout, naming the services that were not up.</objective>
            </script>
        </run>

        <!-- @page mde-ts_example-ts_contract Contract (H2)
              @objective Compare guess of the TypeScript example with the Go and C# examples.

              @par Scenario:
              -# Fail with "H1 build missing" when dist/index.js does not exist.
              -# Check the comparison against planted differences.
              -# Start the services; a port not open within 10 s is a "start-up fault".
              -# Log what the TypeScript process listens on (tapi_netexpose).
              -# Run ./scripts/run.sh guess and the same input on Go and C#; log all outputs in full.
              -# Compare the answer lines and exit codes; print both values on a mismatch.
        -->
        <run name="ts_contract">
            <script name="ts_contract">
                <objective>[H2] Run guess for the TypeScript example and the same input for the Go and C# examples, log all three outputs, compare answer lines and exit codes. H2 PASS when the three match; H2 FAIL mismatch with both values; "H1 build missing" when dist/index.js is absent; "H2 start-up fault" when a port is not open within 10 s.</objective>
            </script>
        </run>

        <!-- @page mde-ts_example-ts_robust Endpoint Variable and a Silent Peer (H3)
              @objective Three checks with their own messages, plus bad input.

              @par Scenario:
              -# (a) Scan src/ outside comments for a literal http://, https:// or IP address.
              -# (b) Run with GUESS_ENDPOINT on a chosen local port; it must connect there and nowhere else.
              -# (c) Point GUESS_ENDPOINT at a listener that never answers; non-zero exit within 10 s.
              -# (d) Empty, non-numeric and oversize input: no hang, signal or trace.
        -->
        <run name="ts_robust">
            <script name="ts_robust">
                <objective>[H3] (a) no literal URL or IP in the TypeScript source outside comments; (b) the example connects to the port in GUESS_ENDPOINT and no other; (c) against a listener that never answers it exits non-zero within 10 s, elapsed time and exit code logged; (d) bad input ends cleanly. The verdict names the failing check; "H1 build missing" when dist/index.js is absent.</objective>
            </script>
        </run>
    </session>
</package>
