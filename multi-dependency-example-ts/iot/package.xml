<?xml version="1.0" ?>
<package version="1.0">
    <description>IoT radio and bus tests</description>

    <!-- @page mde-iot IoT Tests
          @objective Carry the ring's data over the radio and bus codecs of
                     the tsf-* modules and audit what they give away.

          @par Test Groups:
          - @ref mde-iot-frames_802154 - IEEE 802.15.4 frames with AES-CCM*
          - @ref mde-iot-frames_lorawan - LoRaWAN frames with AES/CMAC
          - @ref mde-iot-sdr           - software defined radio without a radio
          - @ref mde-iot-can_bus       - CAN frames over a virtual bus
          - @ref mde-iot-bluetooth     - the Bluetooth support matrix

          @par Notes:
          - The DUT has no radio, bus or Bluetooth hardware. The frame
            codecs (802.15.4, LoRaWAN) run engine-side and are checked by
            deep round trips over the ring's own values. CAN uses a virtual
            vcan interface created with sudo. SDR and Bluetooth skip the
            hardware path cleanly and exercise only what needs none.
    -->

    <author mailto="maximmenshchikov@gmail.com" />

    <session track_conf="silent">
        <!-- @page mde-iot-prologue IoT Group Prologue
              @objective Chart which radio and bus tools the agent has.

              @par Scenario:
              -# Probe each tool and chart its presence.
        -->
        <prologue>
            <script name="prologue">
                <objective>
                    Chart which radio and bus tools the agent has.

                    @md
                </objective>
            </script>
        </prologue>

        <!-- @page mde-iot-epilogue IoT Group Epilogue
              @objective Finalize the iot group.

              @par Scenario:
              -# No group-wide cleanup is required.
        -->
        <epilogue>
            <script name="epilogue">
                <objective>
                    Finalize the iot group.

                    @md
                </objective>
            </script>
        </epilogue>

        <!-- @page mde-iot-frames_802154 802.15.4 Frames
              @objective Encode the ring's steps as 802.15.4 data frames with
                         AES-CCM*, parse them back and audit them.

              @par Test Parameters:
              | Parameter    | Values                               | Description                     |
              |==============|======================================|=================================|
              | security     | none / mic32 / enc-mic64 / enc-mic128| How much each frame is protected|
              | hops         | 1 / 5                                | Ring hop budget for the payload |
              | min_severity | high / critical                      | Failing threshold               |

              @par Scenario:
              -# Collect the model's walk and cpp-demo's trace as payload.
              -# Encode each step as a secured frame; parse it back and check
                 every field, the MIC and the ring step bit for bit.
              -# Control: flip one payload byte - the FCS must fail, and at a
                 secured level the MIC too (security=none has no MIC).
              -# Control (secured levels): two frames differing only in the
                 sequence number must get different MICs, and a forged
                 sequence number behind a recomputed FCS must fail the MIC.
              -# Control: at an encrypting level, two frames under one counter
                 share a keystream (ciphertext XOR == plaintext XOR).
              -# Controls: planted counter reuse, counter reset and known key.
              -# Audit the frames and gate on the severity threshold.

              @par Expected Results:
              - Every round trip is exact; the controls are all detected.
              - The security=none iteration plants unsecured frames and is the
                control of the unsecured-frames finding; security=mic32 is the
                control of the weak-security-level finding. Both are dropped
                before the gate, so a correct run of the module PASSES.
              - Known module defect (tsf-802154): at security=mic32 the MIC
                is never verified (tapi_802154_unsecure() skips
                EVP_CipherFinal_ex) and does not cover the header (header and
                payload go to CCM as two separate AAD pieces). Those
                iterations FAIL with the two verdicts naming this.
        -->
        <run name="frames_802154">
            <script name="frames_802154">
                <objective>
                    802.15.4 frames carrying the ring, round-tripped and
                    audited.

                    @md
                </objective>
            </script>
            <arg name="security">
                <value>none</value>
                <value>mic32</value>
                <value>enc-mic64</value>
                <value>enc-mic128</value>
            </arg>
            <arg name="hops">
                <value>1</value>
                <value>5</value>
            </arg>
            <arg name="min_severity">
                <value>high</value>
                <value>critical</value>
            </arg>
        </run>

        <!-- @page mde-iot-frames_lorawan LoRaWAN Frames
              @objective Encode the ring's steps as LoRaWAN frames, verify the
                         MIC against an independent AES-CMAC and audit them.

              @par Test Parameters:
              | Parameter    | Values          | Description                     |
              |==============|=================|=================================|
              | fport        | 1 / 42          | Application port                |
              | dir          | up / down       | Uplink or downlink              |
              | hops         | 5               | Ring hop budget for the payload |
              | min_severity | high / critical | Failing threshold               |

              @par Scenario:
              -# Derive the session keys and check them against OpenSSL.
              -# Build, verify and decrypt a frame per ring step; check the
                 MIC against an independent AES-CMAC over B0 and the frame.
              -# Control: one flipped bit must fail the MIC.
              -# Controls: planted counter reuse, counter reset, a known key
                 and equal session keys.
              -# Audit the frames and gate on the severity threshold.

              @par Expected Results:
              - The derived keys match the specification; every MIC matches
                the independent one; every round trip is exact; the controls
                are all detected. A correct run of the module PASSES.
        -->
        <run name="frames_lorawan">
            <script name="frames_lorawan">
                <objective>
                    LoRaWAN frames carrying the ring, MIC cross-checked and
                    audited.

                    @md
                </objective>
            </script>
            <arg name="fport">
                <value>1</value>
                <value>42</value>
            </arg>
            <arg name="dir">
                <value>up</value>
                <value>down</value>
            </arg>
            <arg name="hops">
                <value>5</value>
            </arg>
            <arg name="min_severity">
                <value>high</value>
                <value>critical</value>
            </arg>
        </run>

        <!-- @page mde-iot-sdr Software Defined Radio
              @objective Chart the backends' features, then decode a synthetic
                         recording with rtl_433 - the half that needs no radio.

              @par Test Parameters:
              | Parameter    | Values            | Description                 |
              |==============|===================|=============================|
              | seconds      | 2                 | Length of the synthetic IQ  |
              | min_severity | medium / critical | Failing threshold           |

              @par Scenario:
              -# Check each backend's declared features against the README.
              -# Ask the agent for a radio through each backend (expected: none)
                 and chart what answered.
              -# Synthesise two identical IQ captures timed by the ring values.
              -# Decode one with rtl_433; silence is an answer.
              -# Control: a missing file must be an error.
              -# Control: comparing two identical captures must report something
                 (nothing-decoded or repeats-itself), never be silent.

              @par Expected Results:
              - With no SDR hardware and rtl_433 present, the feature and probe
                charts are drawn, the synthetic capture decodes (to nothing),
                the controls pass and the test PASSES. Without rtl_433 and
                without a receiver it SKIPS with that reason.
              - Known module defect (tsf-sdr): rtl_433 22.11 (Debian
                bookworm) exits 0 after "Opening file ... failed!", and
                tapi_sdr_decode() trusts the exit status, so a missing
                capture reads as an empty one. The test then FAILS with a
                verdict naming this, backed by rtl_433's own output.
        -->
        <run name="sdr">
            <script name="sdr">
                <objective>
                    SDR features, detection, and rtl_433 over a synthetic
                    capture.

                    @md
                </objective>
            </script>
            <arg name="seconds">
                <value>2</value>
            </arg>
            <arg name="min_severity">
                <value>medium</value>
                <value>critical</value>
            </arg>
        </run>

        <!-- @page mde-iot-can_bus CAN Bus
              @objective Send the ring's values as CAN frames on a virtual bus,
                         capture and decode them, and probe UDS.

              @par Test Parameters:
              | Parameter    | Values            | Description                 |
              |==============|===================|=============================|
              | hops         | 5 / 7             | Ring hop budget             |
              | min_severity | medium / critical | Failing threshold           |

              @par Scenario:
              -# Create vcan0 with sudo; skip if the module or sudo is absent.
              -# Send one frame per ring step (id 0x100+stage); a CAN FD frame
                 too where the kernel supports it.
              -# Capture with candump, decode and verify each round trip.
              -# Control: a UDS probe on an empty bus must get no response.
              -# Control: a planted diagnostic response is reported.
              -# Remove vcan0 in cleanup.

              @par Expected Results:
              - With vcan available the round trips are exact and the controls
                pass, so the test PASSES. Without the vcan module or sudo it
                SKIPS with that reason.
        -->
        <run name="can_bus">
            <script name="can_bus">
                <objective>
                    Ring values over a virtual CAN bus, round-tripped, plus a
                    UDS probe.

                    @md
                </objective>
            </script>
            <arg name="hops">
                <value>5</value>
                <value>7</value>
            </arg>
            <arg name="min_severity">
                <value>medium</value>
                <value>critical</value>
            </arg>
        </run>

        <!-- @page mde-iot-bluetooth Bluetooth Support Matrix
              @objective Chart what each Bluetooth backend supports and check
                         the address normaliser; skip the live adapter work.

              @par Scenario:
              -# Chart the feature matrix of every backend.
              -# Check the address normaliser against known vectors.
              -# Skip the adapter read, scan and audit: there is no adapter.

              @par Expected Results:
              - The matrix and normaliser checks pass and the test SKIPS at the
                live-adapter step with a concrete reason (no AF_BLUETOOTH stack
                in the container).
        -->
        <run name="bluetooth">
            <script name="bluetooth">
                <objective>
                    The Bluetooth support matrix and address normaliser.

                    @md
                </objective>
            </script>
        </run>
    </session>
</package>
