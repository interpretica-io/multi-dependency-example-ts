<?xml version="1.0" ?>
<package version="1.0">
    <description>The example under a fake clock</description>

    <!-- @page mde-time Time Tests
          @objective Run the example and its TLS clients under a clock that
                     is not the machine's (tsf-time, libfaketime) and check
                     what depends on it and what must not.

          @par Test Groups:
          - @ref mde-time-shim_check         - the shim moves the clock as asked
          - @ref mde-time-ring_under_time    - the ring does not care
          - @ref mde-time-cert_expiry_travel - certificates expire on time
          - @ref mde-time-web_under_time     - a service under the fake clock

          @par Notes:
          - Every test proves the clock moved (tapi_time_check) before it
            believes anything it sees.
          - Short-lived programs are wrapped with faketime
            (tapi_time_wrap); long-running services get LD_PRELOAD and
            FAKETIME in their own environment (tapi_time_env), because
            faketime forks and would outlive a stopped job.
    -->

    <author mailto="maximmenshchikov@gmail.com" />

    <session track_conf="silent">
        <!-- @page mde-time-prologue Time Group Prologue
              @objective Report the tools the group needs.

              @par Scenario:
              -# Check faketime, date, curl, openssl, python3 and log
                 versions.
              -# Chart which of them are present.
        -->
        <prologue>
            <script name="prologue">
                <objective>
                    Report the tools of the time group.

                    @md
                </objective>
            </script>
        </prologue>

        <!-- @page mde-time-epilogue Time Group Epilogue
              @objective Finalize the time group.

              @par Scenario:
              -# No cleanup actions are required.
        -->
        <epilogue>
            <script name="epilogue">
                <objective>
                    Finalize the time group.

                    @md
                </objective>
            </script>
        </epilogue>

        <!-- @page mde-time-shim_check The Shim Moves the Clock
              @objective For offsets -1y, -1d, 0, +1d and +10y, `date +%s`
                         under the shim must differ from the real clock by
                         the offset within 10 s.

              @par Test Parameters:
              | Parameter | Values     | Description                               |
              |===========|============|===========================================|
              | method    | env / wrap | tapi_time_env (via tapi_time_check) or the faketime wrapper |

              @par Scenario:
              -# Skip without libfaketime (and the faketime program for
                 wrap).
              -# Known-bad control: a shim library path that does not exist
                 must be reported as time.shim-not-effective; drop it.
              -# For each offset measure the skew; a difference of more
                 than 10 s from the request is time.shim-not-effective
                 (high).
              -# Chart observed vs requested days and the error.
              -# Gate the report at high.

              @par Expected Results:
              - Both methods move the clock exactly: the test passes.
        -->
        <run name="shim_check">
            <script name="shim_check">
                <objective>
                    Prove the fake clock moves by what was asked.

                    @md
                </objective>
            </script>

            <arg name="method">
                <value>env</value>
                <value>wrap</value>
            </arg>
        </run>

        <!-- @page mde-time-ring_under_time The Ring under a Fake Clock
              @objective The ring computes from its inputs only: a demo run
                         under a clock years away must print exactly what it
                         prints on the real clock.

              @par Test Parameters:
              | Parameter    | Values                | Description                 |
              |==============|=======================|=============================|
              | offset       | -10y / +10y / +100y   | Fake clock offset           |
              | demo         | cpp / rust / py       | Demo that enters the ring   |
              | min_severity | high                  | Lowest severity that fails  |

              @par Scenario:
              -# Prove the clock moves by the offset (tapi_time_check).
              -# Known-bad control: `date +%Y` real vs faked must be reported
                 as time.behaviour-changes; drop it.
              -# Run the demo on the real clock (must exit 0) and under
                 tapi_time_wrap.
              -# Compare: a death is time.crash (critical), a hang
                 time.hang, a different exit, output (hash), stage step or
                 result time.behaviour-changes (high).
              -# Chart stage outputs real vs faked, run times, step counts.
              -# Gate the report at min_severity.

              @par Expected Results:
              - Identical traces at every offset: the test passes, also on
                the shipped (defective) example, whose one-stage trace is
                the same on both clocks.
        -->
        <run name="ring_under_time">
            <script name="ring_under_time">
                <objective>
                    Run a demo of the ring under a fake clock and compare it
                    with the real-clock run.

                    @md
                </objective>
            </script>

            <arg name="offset">
                <value>-10y</value>
                <value>+10y</value>
                <value>+100y</value>
            </arg>
            <arg name="demo">
                <value>cpp</value>
                <value>rust</value>
                <value>py</value>
            </arg>
            <arg name="min_severity">
                <value>high</value>
            </arg>
        </run>

        <!-- @page mde-time-cert_expiry_travel Certificate Expiry by Time Travel
              @objective A client trusting a one-day certificate must connect
                         now and refuse two days back and two days ahead.

              @par Test Parameters:
              | Parameter | Values         | Description          |
              |===========|================|======================|
              | client    | curl / python3 | TLS client under test |

              @par Scenario:
              -# Make a self-signed certificate for localhost valid for one
                 day.
              -# For -2d, +0 and +2d: prove the clock moved, serve the
                 certificate with tapi_tls_server (one connection), run the
                 client under tapi_time_wrap trusting exactly that
                 certificate, read from the server whether it connected.
              -# +0 must connect (positive control, verdict otherwise); a
                 connection at +2d is tls.client-accepts-expired, at -2d
                 time.not-yet-valid-accepted (critical).
              -# Known-bad control: curl -k at +2d must be reported; drop it.
              -# Chart outcome and exit status per offset, observed skew.
              -# Gate the report at high.

              @par Expected Results:
              - Connected at +0, refused at -2d and +2d: the test passes.
        -->
        <run name="cert_expiry_travel">
            <script name="cert_expiry_travel">
                <objective>
                    Make a certificate expire by moving the client's clock.

                    @md
                </objective>
            </script>

            <arg name="client">
                <value>curl</value>
                <value>python3</value>
            </arg>
        </run>

        <!-- @page mde-time-web_under_time A Service under a Fake Clock
              @objective A service of the web tier started under the fake
                         clock must start and answer GET /ring exactly as on
                         the real clock.

              @par Test Parameters:
              | Parameter    | Values                               | Description                |
              |==============|======================================|============================|
              | service      | gateway-rs / service-go / service-cs | Service of the tier        |
              | offset       | +1d / +10y                           | Fake clock offset          |
              | min_severity | high                                 | Lowest severity that fails |

              @par Scenario:
              -# Prove the clock moves by the offset.
              -# Start the service alone on the real clock (minimal
                 environment), ask /ring?hops=0, read /proc/PID/maps.
              -# Known-bad control: libfaketime must not be found in the
                 real-clock process (time.shim-not-loaded); drop it.
              -# Start it again with the tapi_time_env environment and ask
                 again.
              -# Not starting is time.service-wont-start, not answering
                 time.service-unresponsive, a different answer
                 time.behaviour-changes (high); a shim missing from the
                 maps is time.shim-not-loaded (medium).
              -# Chart start and response times, shim presence.
              -# Gate the report at min_severity.

              @par Expected Results:
              - Every service starts and answers the same: the test passes.
        -->
        <run name="web_under_time">
            <script name="web_under_time">
                <objective>
                    Start a service of the web tier under a fake clock and
                    compare its answer with the real-clock one.

                    @md
                </objective>
            </script>

            <arg name="service">
                <value>gateway-rs</value>
                <value>service-go</value>
                <value>service-cs</value>
            </arg>
            <arg name="offset">
                <value>+1d</value>
                <value>+10y</value>
            </arg>
            <arg name="min_severity">
                <value>high</value>
            </arg>
        </run>
    </session>
</package>
