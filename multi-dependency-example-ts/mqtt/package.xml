<?xml version="1.0" ?>
<package version="1.0">
    <description>MQTT tests: ring results over a broker on the agent</description>

    <!-- @page mde-mqtt MQTT Tests
          @objective Carry the ring's results over a real MQTT broker and
                     audit the broker the module stands up.

          @par Test Groups:
          - @ref mde-mqtt-ring_bus     - the ring trace published and read back
          - @ref mde-mqtt-broker_audit - a broker's posture, with a known-bad control
          - @ref mde-mqtt-retained     - retained delivery, kept and cleared

          @par Notes:
          - The DUT has no MQTT of its own; the broker is a transport and an
            evidence channel for the ring's results, stood up on the agent
            with tapi_mqtt_broker.
          - ring_bus carries the observed trace over MQTT (a byte-exact
            round-trip) and then compares it to the reference model, so the
            injected always-true defect fails the test with a known-issue
            verdict on the shipped example.
    -->

    <author mailto="maximmenshchikov@gmail.com" />

    <session track_conf="silent">
        <!-- @page mde-mqtt-prologue MQTT Group Prologue
              @objective Prepare the mqtt group.

              @par Scenario:
              -# No special setup is required.
        -->
        <prologue>
            <script name="prologue">
                <objective>
                    Prepare the mqtt group.

                    @md
                </objective>
            </script>
        </prologue>

        <!-- @page mde-mqtt-epilogue MQTT Group Epilogue
              @objective Finalize the mqtt group.

              @par Scenario:
              -# No cleanup actions are required.
        -->
        <epilogue>
            <script name="epilogue">
                <objective>
                    Finalize the mqtt group.

                    @md
                </objective>
            </script>
        </epilogue>

        <!-- @page mde-mqtt-ring_bus Ring Over MQTT
              @objective Carry every parsed ring step over a broker and verify
                         the round-trip, then compare the trace to the model.

              @par Test Parameters:
              | Parameter | Values  | Description                           |
              |===========|=========|=======================================|
              | qos       | 0 / 1 / 2 | MQTT quality of service to use      |
              | hops      | 1 / 5   | Hop budget cpp-demo is run with       |

              @par Scenario:
              -# Stand up an authenticated mosquitto broker on the agent.
              -# Run cpp-demo and parse every stage step it printed.
              -# Publish each step retained on mde/ring/<i>/<stage> as
                 "hops in out".
              -# Subscribe afresh and collect them all back.
              -# Assert the count and every payload byte-for-byte.
              -# Compare the carried trace against the reference model.

              @par Expected Results:
              - Correct ring: hops+1 steps carried, all round-trip, trace
                matches the model.
              - As-shipped (defective) example: the round-trip is sound but
                only one step is traced, so the model comparison fails with a
                known-issue verdict.
        -->
        <run name="ring_bus">
            <script name="ring_bus">
                <objective>
                    Carry the ring trace over MQTT and compare it to the
                    model.

                    @md
                </objective>
            </script>
            <arg name="qos">
                <value>0</value>
                <value>1</value>
                <value>2</value>
            </arg>
            <arg name="hops">
                <value>1</value>
                <value>5</value>
            </arg>
        </run>

        <!-- @page mde-mqtt-broker_audit MQTT Broker Audit
              @objective Audit a hardened broker (expect clean) next to an
                         anonymous known-bad control (expect findings).

              @par Test Parameters:
              | Parameter    | Values          | Description               |
              |==============|=================|===========================|
              | min_severity | high / critical | Failing threshold         |

              @par Scenario:
              -# Stand up a hardened broker and audit it as a stranger.
              -# Stand up an anonymous broker as a control and audit it too.
              -# Assert the control's anonymous finding was caught.
              -# Drop the control's findings and gate on the hardened one.

              @par Expected Results:
              - The hardened broker has no finding at or above the threshold.
              - The audit catches the anonymous control, so the test does not
                stop with a blind-audit verdict.
        -->
        <run name="broker_audit">
            <script name="broker_audit">
                <objective>
                    The posture of a broker, with a known-bad control.

                    @md
                </objective>
            </script>
            <arg name="min_severity">
                <value>high</value>
                <value>critical</value>
            </arg>
        </run>

        <!-- @page mde-mqtt-retained MQTT Retained Delivery
              @objective A retained ring result is kept and handed to a fresh
                         subscription exactly once, and is gone once cleared.

              @par Scenario:
              -# Publish a ring result retained.
              -# Subscribe afresh and receive it exactly once, unchanged.
              -# Clear it and confirm a fresh subscription finds nothing.

              @par Expected Results:
              - Exactly one identical retained message comes back, then none.
        -->
        <run name="retained">
            <script name="retained">
                <objective>
                    Retained delivery: kept once, then cleared.

                    @md
                </objective>
            </script>
        </run>
    </session>
</package>
