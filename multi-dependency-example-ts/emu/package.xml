<?xml version="1.0" ?>
<package version="1.0">
    <description>Emulator tests</description>

    <!-- @page mde-emu Emulator Tests
          @objective Use a QEMU machine as a place to drive and break
                     things: its run states over QMP, snapshots that put it
                     back exactly, and a guest with no operating system
                     that talks on the serial port (tsf-emu).

          @par Test Groups:
          - @ref mde-emu-qmp_lifecycle  - run states over QMP, three views per transition
          - @ref mde-emu-snapshot       - savevm / loadvm restoring registers and memory
          - @ref mde-emu-serial_console - a multiboot guest printing MDE-OK

          @par Notes:
          - The agent has no /dev/kvm: every machine runs with accel=tcg.
          - The guest of snapshot and serial_console is a 32-bit multiboot
            ELF assembled on the agent with tapi_cc; it prints MDE-OK on
            COM1, COM2 and the debug console, then counts in ECX and at
            physical address 0x500.
          - tapi_emu_console() only drains COM1 when the machine stops, so
            the live line is read from COM2 and debugcon files.
    -->

    <author mailto="maximmenshchikov@gmail.com" />

    <session track_conf="silent">
        <!-- @page mde-emu-prologue Emulator Group Prologue
              @objective Check QEMU and python3 are there; record versions
                         and whether KVM exists.

              @par Scenario:
              -# Skip the group without qemu-system-x86_64 or python3.
              -# Record qemu and qemu-img versions and /dev/kvm presence.
        -->
        <prologue>
            <script name="prologue">
                <objective>
                    Check QEMU is available and record versions.

                    @md
                </objective>
            </script>
        </prologue>

        <!-- @page mde-emu-epilogue Emulator Group Epilogue
              @objective Remove the group's scratch files on the agent.

              @par Scenario:
              -# Remove /tmp/mde-emu and the screendump.
        -->
        <epilogue>
            <script name="epilogue">
                <objective>
                    Remove the group's scratch files.

                    @md
                </objective>
            </script>
        </epilogue>

        <!-- @page mde-emu-qmp_lifecycle QMP Lifecycle
              @objective Take a disk-less machine through its run states
                         over QMP and check each transition three ways.

              @par Test Parameters:
              | Parameter | Values   | Description              |
              |===========|==========|==========================|
              | machine   | pc / q35 | QEMU machine type        |
              | cycles    | 1 / 3    | cont/stop/reset cycles   |

              @par Scenario:
              -# Start with -S and a VGA device; state must be stopped.
              -# query-version against qemu-system-x86_64 ‑‑version.
              -# Per cycle: cont (running), stop (paused), system_reset
                 (stopped, EIP at the reset vector 0xfff0); each state is
                 read by tapi_emu_state_get, query-status and HMP.
              -# cont again; screendump to /tmp/mde-emu-screen.ppm and
                 check its size against the PPM header; sha256 logged.
              -# Chart the latency of every QMP command.

              @par Expected Results:
              - Passes.
        -->
        <run name="qmp_lifecycle">
            <script name="qmp_lifecycle">
                <objective>
                    Drive a machine through its run states over QMP.

                    @md
                </objective>
            </script>

            <arg name="machine">
                <value>pc</value>
                <value>q35</value>
            </arg>
            <arg name="cycles">
                <value>1</value>
                <value>3</value>
            </arg>
        </run>

        <!-- @page mde-emu-snapshot Snapshots
              @objective Check savevm/loadvm restore the CPU and memory of
                         a running guest exactly.

              @par Test Parameters:
              | Parameter | Values | Description                    |
              |===========|========|================================|
              | cycles    | 1 / 3  | save / run on / load cycles    |

              @par Scenario:
              -# Build the counting guest; create a 16M qcow2 with qemu-img.
              -# Boot it with the disk; wait for the counter.
              -# Per cycle: stop, read ECX and [0x500], savevm (listed by
                 HMP and by qemu-img -U); run 1 s (ECX must move); loadvm;
                 ECX and [0x500] must equal the saved ones.
              -# Known-bad control: loadvm of a name never saved is refused.
              -# delvm; neither view lists it.
              -# Chart savevm/loadvm/delvm time and the counter.

              @par Expected Results:
              - Passes; skips without qemu-img or a 32-bit toolchain.
        -->
        <run name="snapshot">
            <script name="snapshot">
                <objective>
                    Save, run on and load back a machine.

                    @md
                </objective>
            </script>

            <arg name="cycles">
                <value>1</value>
                <value>3</value>
            </arg>
        </run>

        <!-- @page mde-emu-serial_console Serial Console
              @objective Boot a guest with no operating system and wait for
                         the line it writes to the serial ports.

              @par Test Parameters:
              | Parameter | Values   | Description       |
              |===========|==========|===================|
              | machine   | pc / q35 | QEMU machine type |

              @par Scenario:
              -# Build the guest; boot it with -kernel, COM2 and debugcon
                 to files on the agent.
              -# Poll debugcon until MDE-OK appears (60 s budget).
              -# COM2 and debugcon must both hold exactly "MDE-OK\n".
              -# Record what tapi_emu_console() holds while running.
              -# The counter must keep moving; ECX and [0x500] agree.
              -# Chart boot-to-line time and the counter.

              @par Expected Results:
              - Passes; skips without a 32-bit toolchain.
        -->
        <run name="serial_console">
            <script name="serial_console">
                <objective>
                    Wait for a bare-metal guest's line on the serial ports.

                    @md
                </objective>
            </script>

            <arg name="machine">
                <value>pc</value>
                <value>q35</value>
            </arg>
        </run>
    </session>
</package>
