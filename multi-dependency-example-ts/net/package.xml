<?xml version="1.0" ?>
<package version="1.0">
    <description>VPN and Wi-Fi Configurator subtree tests</description>

    <!-- @page mde-net Networking Tests
          @objective Drive the /agent/vpn and /agent/wifi Configurator
                     subtrees the external tsf-tunnel and tsf-wifi agent
                     libraries contribute.

          @par Test Groups:
          - @ref mde-net-vpn_tree      - the /agent/vpn subtree is registered
          - @ref mde-net-wifi_tree     - the /agent/wifi subtree is registered
          - @ref mde-net-wg_tunnel     - a real WireGuard tunnel, kernel permitting
          - @ref mde-net-ipsec_builder - several IPsec SA configurations

          @par Notes:
          - Every set under /agent/vpn commits immediately and would apply to
            the kernel, which here has neither the wireguard module nor xfrm.
            So vpn_tree stays on the kernel-free nodes (backend, add/remove),
            ipsec_builder stages its SA configurations with local Configurator
            operations and never commits, and wg_tunnel probes for the module
            first and skips when it is absent. The /agent/wifi subtree commits
            nothing while the interface is left disabled, so wifi_tree drives
            every field live.
    -->

    <author mailto="maximmenshchikov@gmail.com" />

    <session track_conf="silent">
        <!-- @page mde-net-prologue Networking Group Prologue
              @objective Chart the instances of each external subtree.

              @par Scenario:
              -# Count and chart /agent/vpn and /agent/wifi instances.
        -->
        <prologue>
            <script name="prologue">
                <objective>
                    Chart the instances of each external subtree.

                    @md
                </objective>
            </script>
        </prologue>

        <!-- @page mde-net-epilogue Networking Group Epilogue
              @objective Finalize the net group.

              @par Scenario:
              -# No group-wide cleanup is required.
        -->
        <epilogue>
            <script name="epilogue">
                <objective>
                    Finalize the net group.

                    @md
                </objective>
            </script>
        </epilogue>

        <!-- @page mde-net-vpn_tree VPN Subtree
              @objective Prove /agent/vpn is registered and its live handlers
                         answer, without needing a kernel.

              @par Scenario:
              -# cfg_find_pattern on /agent:Agt_A/vpn:* - non-empty proves
                 ta_vpn was linked and cm_vpn.yml loaded.
              -# Round-trip the backend node through the live agent handler
                 (its commit over an empty model touches no kernel).
              -# Add and then remove a WireGuard interface; chart the growth.

              @par Expected Results:
              - PASS: the subtree is registered, the backend round-trips and
                the interface is added and removed.
        -->
        <run name="vpn_tree">
            <script name="vpn_tree">
                <objective>
                    The /agent/vpn subtree is registered and its handlers
                    answer.

                    @md
                </objective>
            </script>
        </run>

        <!-- @page mde-net-wifi_tree Wi-Fi Subtree
              @objective Describe a station through /agent/wifi and read every
                         field back, exercising the live ta_wifi handlers.

              @par Scenario:
              -# cfg_find_pattern on /agent:Agt_A/wifi:* proves registration.
              -# Add a port and an SSID; set ifname, standard, channel, width,
                 name, mode, security, protocol and passphrase - the interface
                 is left disabled, so the commit each set triggers applies
                 nothing.
              -# Read every field back and compare (deep check).
              -# Control: a bad enum value must be refused.

              @par Expected Results:
              - PASS: every field round-trips and the bad enum is rejected.
        -->
        <run name="wifi_tree">
            <script name="wifi_tree">
                <objective>
                    The /agent/wifi subtree round-trips every field.

                    @md
                </objective>
            </script>
        </run>

        <!-- @page mde-net-wg_tunnel WireGuard Tunnel
              @objective Commit a real WireGuard interface and read its applied
                         state back, when the kernel can carry one.

              @par Scenario:
              -# Probe whether a WireGuard interface can be created at all.
              -# Generate a key on the agent, configure the interface and a
                 peer, commit.
              -# Read the listen port, peer endpoint, allowed IPs and status
                 back; read the handshake age.
              -# Remove the interface.

              @par Expected Results:
              - With the wireguard module and NET_ADMIN: PASS. In the shipped
                container the module is absent, so the test SKIPS with that
                concrete reason.
        -->
        <run name="wg_tunnel">
            <script name="wg_tunnel">
                <objective>
                    A real WireGuard tunnel through the subtree, kernel
                    permitting.

                    @md
                </objective>
            </script>
        </run>

        <!-- @page mde-net-ipsec_builder IPsec SA Configurations
              @objective Add several IPsec SAs to the subtree and verify each
                         is ESP, tunnel mode and null-encrypted by default -
                         the misconfiguration the low-level subtree makes
                         catchable.

              @par Scenario:
              -# Add three IPsec SAs (read_create, no commit, no kernel).
              -# Synchronize and read each SA's proto, mode and enc_alg back.
              -# Assert ESP, tunnel mode and an empty enc_alg (null encryption)
                 on every one.

              @par Expected Results:
              - PASS: every SA defaults to a null-encrypted ESP tunnel.
                Rendering the "ip xfrm state add ..." text and applying an SA
                need the agent-side builder and the xfrm kernel, neither of
                which is reachable here; that is stated in an artifact.
        -->
        <run name="ipsec_builder">
            <script name="ipsec_builder">
                <objective>
                    Several IPsec SA configurations, including the
                    null-encrypted one, verified field by field.

                    @md
                </objective>
            </script>
        </run>
    </session>
</package>
