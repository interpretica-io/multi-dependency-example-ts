<?xml version="1.0" ?>
<package version="1.0">
    <description>Kernel tests</description>

    <!-- @page mde-kernel Kernel Tests
          @objective The agent kernel under the example: its hardening
                     posture, the kernel log while the example runs, the
                     resources the web tier holds, the modules and the
                     configuration, and exec tracing of the demos
                     (tsf-kernel).

          @par Test Groups:
          - @ref mde-kernel-posture     - hardening posture, two views of the release
          - @ref mde-kernel-kmsg_window - kernel log window around a workload
          - @ref mde-kernel-resources   - RSS, descriptors, threads under a burst
          - @ref mde-kernel-modules     - modules and hardening options
          - @ref mde-kernel-ktrace      - exec tracing of the ring demos

          @par Notes:
          - In the build container the kernel is the host's. Its weaknesses
            are reported as ranked findings, and the min_severity parameter
            decides what fails; only what the example itself does
            (crashing, leaking) is ranked high or critical.
          - Reading the kernel log and tracefs needs privileges a container
            usually lacks; those tests try sudo and skip with a reason.
    -->

    <author mailto="maximmenshchikov@gmail.com" />

    <session track_conf="silent">
        <!-- @page mde-kernel-prologue Kernel Group Prologue
              @objective Record the kernel release and a posture summary.

              @par Scenario:
              -# Open a session on the agent.
              -# Record the kernel release as an artifact.
              -# Take the hardening posture and record its summary.
        -->
        <prologue>
            <script name="prologue">
                <objective>
                    Record the kernel release and a summary of its
                    hardening posture.

                    @md
                </objective>
            </script>
        </prologue>

        <!-- @page mde-kernel-epilogue Kernel Group Epilogue
              @objective Remove what the group left on the agent.

              @par Scenario:
              -# Remove /tmp/mde-kernel-* on the agent.
        -->
        <epilogue>
            <script name="epilogue">
                <objective>
                    Remove what the kernel group left on the agent.

                    @md
                </objective>
            </script>
        </epilogue>

        <!-- @page mde-kernel-posture Kernel Hardening Posture
              @objective Take the hardening posture of the kernel, chart it,
                         rank what is weak, and check that two views of the
                         same facts agree.

              @par Test Parameters:
              | Parameter    | Values          | Description                          |
              |==============|=================|======================================|
              | min_severity | high / critical | Lowest finding severity that fails   |

              @par Scenario:
              -# Take the posture with tapi_kernel_security_posture_get().
              -# Log every field as an artifact.
              -# Compare the release with uname -r and
                 /proc/sys/kernel/osrelease.
              -# Compare randomize_va_space, dmesg_restrict and kptr_restrict
                 with a plain cat of /proc/sys.
              -# Read the command line (nokaslr, mitigations=off).
              -# Rank weak sysctls, lockdown, signatures, LSMs and taint as
                 kernel.posture.* findings (ASLR not full is high, the rest
                 medium or lower).
              -# Chart the hardening flags (1/0), the raw sysctls and the CPU
                 vulnerability states.
              -# Gate on min_severity.

              @par Expected Results:
              - All views agree; on a usual host only low/medium findings,
                so both iterations pass.
        -->
        <run name="posture">
            <script name="posture">
                <objective>
                    Kernel hardening posture: artifacts, charts, ranked
                    findings and a two-view release check.

                    @md
                </objective>
            </script>

            <arg name="min_severity">
                <value>high</value>
                <value>critical</value>
            </arg>
        </run>

        <!-- @page mde-kernel-kmsg_window Kernel Log Window
              @objective Watch the kernel log while the example runs; a
                         fault of one of its binaries is a critical finding.

              @par Test Parameters:
              | Parameter    | Values          | Description                          |
              |==============|=================|======================================|
              | workload     | ring / web      | Ring demos, or the web tier and 20 requests |
              | min_severity | high / critical | Lowest finding severity that fails   |

              @par Scenario:
              -# Find how the log is read (dmesg, sudo -n dmesg); skip if not.
              -# Skip when the kernel does not log user faults.
              -# Build a crashing program on the agent (gcc), or use python3
                 ctypes, as the known-bad control.
              -# Open the window (tsf-kernel marker if /dev/kmsg is writable,
                 the last log line otherwise).
              -# Run the workload, then the control.
              -# Read the window; count lines per priority; turn user-space
                 fault lines into kernel.dut-crash (a binary of the example,
                 critical) or kernel.user-fault (anything else, info);
                 classify kernel events with tsf-kernel (medium).
              -# The control's fault must be there; its finding is dropped.
              -# Chart lines per priority and what the window holds; gate.

              @par Expected Results:
              - The example does not crash: pass.
              - In a container without CAP_SYSLOG: skipped.
        -->
        <run name="kmsg_window">
            <script name="kmsg_window">
                <objective>
                    Kernel log window around a workload: no binary of the
                    example may fault; a deliberate crash must be seen.

                    @md
                </objective>
            </script>

            <arg name="workload">
                <value>ring</value>
                <value>web</value>
            </arg>
            <arg name="min_severity">
                <value>high</value>
                <value>critical</value>
            </arg>
        </run>

        <!-- @page mde-kernel-resources Web Tier Resources Under Load
              @objective Sample RSS, descriptors and threads of every web
                         service before, during and after a burst.

              @par Test Parameters:
              | Parameter     | Values        | Description                            |
              |===============|===============|========================================|
              | workload      | web           | Long-lived processes to sample         |
              | load          | 10 / 50 / 200 | Requests in the burst (5 chunks)       |
              | rss_growth_mb | 64            | RSS growth bound per service, MB       |

              @par Scenario:
              -# Start the web tier; warm its pools up with 5 requests.
              -# Take a tsf-kernel snapshot (files, sockets, tasks, memory)
                 and the first per-service sample from /proc.
              -# Send the burst in 5 chunks, sampling after each; then settle
                 2 s and sample again.
              -# Chart RSS, descriptors and threads over the samples per
                 service and requests per second per chunk.
              -# A service that died or restarted is kernel.service-died;
                 more than 8 extra descriptors is kernel.fd-leak; RSS growth
                 over the bound is kernel.rss-growth; unanswered requests are
                 kernel.web-unanswered.
              -# Compare the system-wide snapshots (released, headroom) as
                 information.
              -# Gate at medium.

              @par Expected Results:
              - No leak, bounded RSS: pass.
        -->
        <run name="resources">
            <script name="resources">
                <objective>
                    Web tier resources before, during and after a burst: no
                    descriptor leak, bounded RSS growth.

                    @md
                </objective>
            </script>

            <arg name="workload">
                <value>web</value>
            </arg>
            <arg name="load">
                <value>10</value>
                <value>50</value>
                <value>200</value>
            </arg>
            <arg name="rss_growth_mb">
                <value>64</value>
            </arg>
        </run>

        <!-- @page mde-kernel-modules Kernel Modules and Configuration
              @objective Inventory the modules and the hardening options of
                         the kernel, read-only.

              @par Test Parameters:
              | Parameter    | Values          | Description                          |
              |==============|=================|======================================|
              | min_severity | high / critical | Lowest finding severity that fails   |

              @par Scenario:
              -# Count /proc/modules lines with the shell.
              -# List modules with tapi_kmod_list(); the counts must agree;
                 a listed module must read as loaded and be found again.
              -# Chart the largest modules and their references.
              -# Read the configuration; chart hardening options (1/0/-1) and
                 rank missing ones (medium at most).
              -# Gate on min_severity.

              @par Expected Results:
              - Views agree, no high findings: pass. A kernel without a
                published configuration charts -1 and passes.
        -->
        <run name="modules">
            <script name="modules">
                <objective>
                    Kernel modules and hardening options, cross-checked and
                    charted.

                    @md
                </objective>
            </script>

            <arg name="min_severity">
                <value>high</value>
                <value>critical</value>
            </arg>
        </run>

        <!-- @page mde-kernel-ktrace Exec Tracing of the Demos
              @objective The kernel must see every demo start.

              @par Scenario:
              -# Find tracefs and how to create an instance (directly, or
                 through sudo); skip when neither works.
              -# Enable sched/sched_process_exec and start tracing.
              -# Run /bin/true (the control) and the three ring demos.
              -# Count exec events per program; every demo missing is
                 kernel.ktrace.exec-missing (high); the control must be seen.
              -# Chart exec events per program; gate at high.

              @par Expected Results:
              - Every exec seen: pass. Without tracefs: skipped.
        -->
        <run name="ktrace">
            <script name="ktrace">
                <objective>
                    Trace sched_process_exec while the ring demos run; every
                    demo and the /bin/true control must be seen.

                    @md
                </objective>
            </script>
        </run>
    </session>
</package>
